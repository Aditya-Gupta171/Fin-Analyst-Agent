  <diagram name="2 · Analysis Pipeline &amp; Agent" id="page-1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="980" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#000000;" value="&lt;b&gt;Analysis Pipeline &amp;amp; Agent Reasoning&lt;/b&gt;">
          <mxGeometry x="40" y="18" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#555555;" value="Deterministic stages turn a filing into a cited fact sheet; the agent reasons over it only when a Groq key is configured; a critic challenges every draft finding before it ships">
          <mxGeometry x="40" y="58" width="1820" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;① INGEST&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#555555;&quot;&gt;no LLM&lt;/span&gt;">
          <mxGeometry x="40" y="110" width="420" height="680" as="geometry" />
        </mxCell>
        <mxCell id="s1a" parent="s1" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" value="&lt;ul style=&quot;margin:0;padding-left:18px;line-height:1.6;&quot;&gt;&lt;li&gt;&lt;b&gt;File in&lt;/b&gt; — NSE / BSE XBRL results, or a DRHP / RHP / annual-report PDF, via upload&lt;/li&gt;&lt;li&gt;&lt;b&gt;Router&lt;/b&gt; sniffs the content (PDF header vs. XML) to pick the parser&lt;/li&gt;&lt;li&gt;&lt;b&gt;XBRL parser&lt;/b&gt; — unit scaling, sign conventions, context-date disambiguation&lt;/li&gt;&lt;li&gt;&lt;b&gt;PDF extractor&lt;/b&gt; — reconstructs tables from word positions (not text extraction, which breaks on split numbers); maps rows to the taxonomy using section context&lt;/li&gt;&lt;li&gt;&lt;b&gt;Merge &amp;amp; reconcile&lt;/b&gt; — combines multiple filings for period comparatives, flags restatements&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;→ canonical &lt;b&gt;FinancialDataset&lt;/b&gt;, every fact with full source provenance&lt;/div&gt;">
          <mxGeometry x="14" y="40" width="392" height="620" as="geometry" />
        </mxCell>

        <mxCell id="s2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;② ENGINE&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#555555;&quot;&gt;deterministic&lt;/span&gt;">
          <mxGeometry x="500" y="110" width="420" height="680" as="geometry" />
        </mxCell>
        <mxCell id="s2a" parent="s2" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" value="&lt;ul style=&quot;margin:0;padding-left:18px;line-height:1.6;&quot;&gt;&lt;li&gt;Validate facts against the taxonomy, drop what doesn't fit (with a reason)&lt;/li&gt;&lt;li&gt;Classify size bucket from annualised revenue&lt;/li&gt;&lt;li&gt;Compute 59 metrics via a safe expression DSL (whitelisted AST, no eval)&lt;/li&gt;&lt;li&gt;Evaluate 55 rules across 5 packs — fired / passed / insufficient-data, three-valued logic (missing data ≠ false)&lt;/li&gt;&lt;li&gt;Detect anomalies — robust (median / MAD) z-score vs. own history and sector cohort&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;→ compact &lt;b&gt;fact sheet&lt;/b&gt; (~1.1K tokens), every value citable&lt;/div&gt;">
          <mxGeometry x="14" y="40" width="392" height="620" as="geometry" />
        </mxCell>

        <mxCell id="s3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;③ AGENT&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#555555;&quot;&gt;LangGraph state machine, only if a Groq key is configured&lt;/span&gt;">
          <mxGeometry x="960" y="110" width="480" height="680" as="geometry" />
        </mxCell>
        <mxCell id="s3a" parent="s3" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" value="&lt;ul style=&quot;margin:0;padding-left:18px;line-height:1.6;&quot;&gt;&lt;li&gt;&lt;b&gt;Plan&lt;/b&gt; — group fired rules / anomalies into enquiries&lt;/li&gt;&lt;li&gt;&lt;b&gt;Investigate&lt;/b&gt; — one ReAct loop per enquiry, 3 read-only tools: metric_history · rule_detail · knowledge_search&lt;/li&gt;&lt;li&gt;&lt;b&gt;Review&lt;/b&gt; — a critic checks every draft finding (evidence, benign explanations, materiality)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Revise&lt;/b&gt; — one pass for findings the critic sends back&lt;/li&gt;&lt;li&gt;&lt;b&gt;Compose&lt;/b&gt; — headline, executive summary, strengths / concerns, overall risk&lt;/li&gt;&lt;li&gt;&lt;b&gt;Propose&lt;/b&gt; — candidate rules for patterns no active rule covers&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;margin-top:10px;font-style:italic;&quot;&gt;Every node falls back to a deterministic result if the model call fails, so an analysis always completes.&lt;/div&gt;">
          <mxGeometry x="14" y="40" width="452" height="620" as="geometry" />
        </mxCell>

        <mxCell id="s4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;④ OUTPUT&lt;/b&gt;">
          <mxGeometry x="1500" y="110" width="360" height="680" as="geometry" />
        </mxCell>
        <mxCell id="s4a" parent="s4" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" value="&lt;ul style=&quot;margin:0;padding-left:18px;line-height:1.6;&quot;&gt;&lt;li&gt;&lt;b&gt;AnalysisReport v1&lt;/b&gt; — versioned JSON: findings, scorecard, integrity, metrics, candidate rules, provenance, full call trace&lt;/li&gt;&lt;li&gt;Persisted (analyses / findings tables) and rendered in the report UI&lt;/li&gt;&lt;li&gt;&lt;b&gt;Rules-only mode&lt;/b&gt; (no Groq key) — findings come straight from fired rules, identical schema&lt;/li&gt;&lt;li&gt;Analyst &lt;b&gt;confirms&lt;/b&gt; or &lt;b&gt;dismisses&lt;/b&gt; each finding →&lt;/li&gt;&lt;/ul&gt;">
          <mxGeometry x="14" y="40" width="332" height="360" as="geometry" />
        </mxCell>
        <mxCell id="s4b" parent="s4" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#f2f2f2;strokeWidth=2;" value="&lt;b&gt;Feeds the self-learning loop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;see page 3 — rule reliability and knowledge-chunk utility both update from this feedback&lt;/span&gt;">
          <mxGeometry x="14" y="410" width="332" height="110" as="geometry" />
        </mxCell>

        <mxCell id="pe1" parent="1" edge="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" parent="1" edge="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" parent="1" edge="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="g" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f2f2f2;" value="&lt;b&gt;GUARDRAILS&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;what keeps the output trustworthy — all verified against the live Groq API, not just in tests&lt;/span&gt;">
          <mxGeometry x="40" y="820" width="1820" height="140" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="g" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Numbers by reference&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;the model writes &amp;#123;&amp;#123;m:key@period&amp;#125;&amp;#125;; the server substitutes the verified value. A hallucinated figure cannot reach the report.&lt;/span&gt;">
          <mxGeometry x="20" y="45" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="g2" parent="g" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Citation guardrail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;check_prose() rejects a bare figure not written as a reference; link_figures() repairs one copied from context.&lt;/span&gt;">
          <mxGeometry x="470" y="45" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="g" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Token &amp;amp; rate-limit discipline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;TokenBudget reads Groq's own rate-limit headers and blocks before exceeding them; ResponseCache never re-costs an identical call.&lt;/span&gt;">
          <mxGeometry x="920" y="45" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="g4" parent="g" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Always completes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;every node has a deterministic fallback (rule-grouped plan, rules-only summary) if the model call fails validation after retries.&lt;/span&gt;">
          <mxGeometry x="1370" y="45" width="430" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · Knowledge Base &amp; Self-Learning" id="page-2">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#000000;" value="&lt;b&gt;Knowledge Base &amp;amp; Self-Learning Loop&lt;/b&gt;">
          <mxGeometry x="40" y="18" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#555555;" value="Semantic knowledge (why it matters) + executable rules (what to check), both closed-loop over analyst feedback — no fine-tuning">
          <mxGeometry x="40" y="58" width="1820" height="24" as="geometry" />
        </mxCell>

        <mxCell id="k" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;KNOWLEDGE BASE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;retrieval — what the agent reads&lt;/span&gt;">
          <mxGeometry x="40" y="110" width="880" height="800" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="k" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Layer A · Curated content&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;49 markdown docs — analyst playbooks, Ind AS notes, SEBI ICDR / LODR, sector primers. One per every rule's kb: reference — enforced by a test.&lt;/span&gt;">
          <mxGeometry x="20" y="50" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="k" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Layer B · Rules catalog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;YAML taxonomy / metrics / rule packs, loaded and cross-validated at startup. Queried directly too, by the agent's rule_detail tool.&lt;/span&gt;">
          <mxGeometry x="20" y="180" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="k" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Hybrid retrieval pipeline&lt;/b&gt;">
          <mxGeometry x="20" y="310" width="840" height="470" as="geometry" />
        </mxCell>
        <mxCell id="k3a" parent="k3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;" value="metadata filter">
          <mxGeometry x="20" y="40" width="800" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k3b" parent="k3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;" value="BM25 (finance-abbreviation expansion)  +  local dense embeddings (fastembed bge-small)">
          <mxGeometry x="20" y="106" width="800" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k3c" parent="k3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;" value="reciprocal rank fusion">
          <mxGeometry x="20" y="172" width="800" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k3d" parent="k3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#ffffff;" value="cross-encoder rerank (top 8)">
          <mxGeometry x="20" y="238" width="800" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k3e" parent="k3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeColor=#000000;fillColor=#f2f2f2;strokeWidth=2;" value="× learned chunk-utility boost  →  top-k chunks">
          <mxGeometry x="20" y="304" width="800" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k3f" parent="k3" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#555555;" value="Falls back to lexical-only when fastembed isn't installed (Render's free tier). Measured: hybrid + rerank scores 93.8% / 98.4% Recall@1 / 3 vs. lexical alone (evals/retrieval.yaml).">
          <mxGeometry x="20" y="368" width="800" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="k" edge="1" source="k3a" target="k3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="k" edge="1" source="k3b" target="k3c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k6" parent="k" edge="1" source="k3c" target="k3d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k7" parent="k" edge="1" source="k3d" target="k3e" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#000000;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="L" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;SELF-LEARNING LOOP&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;feedback-driven, no fine-tuning&lt;/span&gt;">
          <mxGeometry x="960" y="110" width="900" height="800" as="geometry" />
        </mxCell>
        <mxCell id="L1" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;① Analysis completes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;findings persisted · the filing's own metrics join its sector × size × period-kind cohort — rules can reference cohort_pct() / cohort_rank() instead of a static threshold&lt;/span&gt;">
          <mxGeometry x="20" y="50" width="860" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L2" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;② Analyst confirms or dismisses a finding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;recorded as one row per verdict — an audit trail, not just a status flag&lt;/span&gt;">
          <mxGeometry x="20" y="170" width="860" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L3" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;③a Rule reliability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;a Beta(prior, +confirms, +dismisses) posterior mean per rule — starts at the same flat confidence every rule has today, shifts once ~5 real verdicts exist&lt;/span&gt;">
          <mxGeometry x="20" y="290" width="415" height="140" as="geometry" />
        </mxCell>
        <mxCell id="L4" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;③b Chunk utility&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;the same feedback, credited to whichever knowledge chunks the finding cited — boosts or demotes them in the retrieval pipeline (page 3, left)&lt;/span&gt;">
          <mxGeometry x="465" y="290" width="415" height="140" as="geometry" />
        </mxCell>
        <mxCell id="L5" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;④ Candidate rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;when the agent's propose step notices a pattern no active rule covers, it drafts one. A human can then:&lt;/span&gt;">
          <mxGeometry x="20" y="450" width="860" height="80" as="geometry" />
        </mxCell>
        <mxCell id="L6" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;Backtest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;replay the candidate against every stored filing — how often would it have fired, at what severity&lt;/span&gt;">
          <mxGeometry x="20" y="550" width="415" height="110" as="geometry" />
        </mxCell>
        <mxCell id="L7" parent="L" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" value="&lt;b&gt;Human approval&lt;/b&gt;">
