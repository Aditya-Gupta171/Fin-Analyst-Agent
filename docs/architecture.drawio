        <mxCell id="why" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.5;" value="&lt;b&gt;Why closed-loop learning instead of fine-tuning&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;auditable — every score traces to real feedback rows, not opaque weights · reversible — a bad rule is rejected, not retrained away · cheap — no GPUs, no training runs · reproducible — every report records catalog_version, kb_version, prompt_version&lt;/span&gt;">
          <mxGeometry x="40" y="930" width="1820" height="60" as="geometry" />
        </mxCell>
      </root>
