        <mxCell id="be5a" parent="be5" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" value="&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li&gt;plan → investigate (ReAct, 3 tools) → review → revise → compose → propose&lt;/li&gt;&lt;li&gt;gpt-oss-120b (reasoning) · gpt-oss-20b (fast)&lt;/li&gt;&lt;li&gt;every node has a deterministic fallback — an analysis always completes&lt;/li&gt;&lt;li&gt;citation guardrail enforces the core principle&lt;/li&gt;&lt;/ul&gt;">
          <mxGeometry x="12" y="34" width="286" height="226" as="geometry" />
        </mxCell>
        <mxCell id="be6" parent="be" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;strokeColor=#000000;fillColor=#ffffff;" value="&lt;b&gt;KNOWLEDGE SERVICE&lt;/b&gt;">
