        <mxCell id="c45" value="&lt;b&gt;Example&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;after 25 IT-services filings, DSO of 95 days sits at p92 → flagged. For an infra EPC company the same DSO is p40 → not flagged.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;dashed=1;" vertex="1" parent="c37">
          <mxGeometry x="20" y="510" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4d4d4d;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c43" target="c45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;Analyst reviews findings&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;confirm · dismiss with reason · re-grade severity · add note&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="c37">
          <mxGeometry x="310" y="180" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;② Rule reliability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;Beta(α, β) posterior per rule × cohort → calibrated confidence; noisy rules dampened&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="c37">
          <mxGeometry x="310" y="330" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="&lt;b&gt;③ Precedent memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;verdict + context embedded; retrieved as “similar past cases”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="c37">
          <mxGeometry x="310" y="480" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c50" value="&lt;b&gt;④ Retrieval utility&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;chunks behind confirmed findings rank higher; unused ones flagged for rewrite&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="c37">
