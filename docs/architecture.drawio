  <diagram name="4 · Integration &amp; Data Model" id="page-3">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1220" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontColor=#000000;" value="&lt;b&gt;Integration Contract &amp;amp; Data Model&lt;/b&gt;">
          <mxGeometry x="40" y="18" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#555555;" value="The real REST API and the six tables behind it (SQLAlchemy async + Alembic; Supabase Postgres in production, SQLite with zero setup otherwise)">
          <mxGeometry x="40" y="58" width="1820" height="24" as="geometry" />
        </mxCell>

        <mxCell id="api" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;REST API&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;FastAPI — same endpoints the frontend and a future host platform would both use&lt;/span&gt;">
          <mxGeometry x="40" y="110" width="860" height="920" as="geometry" />
        </mxCell>
        <mxCell id="apiTable" parent="api" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #000;padding:4px 6px;&quot;&gt;&lt;b&gt;Method &amp;amp; path&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #000;padding:4px 6px;&quot;&gt;&lt;b&gt;Does&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;white-space:nowrap;&quot;&gt;POST /documents&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Upload a filing (multipart); ingests deterministically, stores the parsed dataset&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /documents, /documents/&amp;#123;id&amp;#125;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;List / fetch an uploaded document&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /documents/&amp;#123;id&amp;#125;/file&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Raw uploaded bytes — the evidence viewer's PDF source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;POST /documents/&amp;#123;id&amp;#125;/analyses&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Queue an analysis job (engine + agent) for that document&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /analyses/&amp;#123;id&amp;#125;, /analyses&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Poll status; the full AnalysisReport once it succeeds&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /analyses/&amp;#123;id&amp;#125;/events&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Server-sent events with live stage / message&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /analyses/&amp;#123;id&amp;#125;/findings&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;The report's findings, normalized for listing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;POST .../findings/&amp;#123;id&amp;#125;/feedback&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Record an analyst's confirm / dismiss verdict&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /rules/candidates&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;List agent-proposed candidate rules&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;POST /rules/candidates/&amp;#123;id&amp;#125;/backtest&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Run a candidate against every stored filing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;POST /rules/candidates/&amp;#123;id&amp;#125;/decision&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Approve (promotes into rules/packs/learned/) or reject&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /rules/reliability&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Feedback-calibrated confidence per rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;GET /health&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;Catalog / knowledge-base / DB readiness&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;">
          <mxGeometry x="16" y="44" width="828" height="500" as="geometry" />
        </mxCell>
        <mxCell id="apiNote" parent="api" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#888888;fillColor=#ffffff;dashed=1;" value="&lt;b&gt;No auth by design, on purpose&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;an optional bearer API key exists (Settings.api_key) but is unset on the live deployment, so a reviewer can use it with no shared secret — Groq's own rate limits bound the cost of that openness.&lt;/span&gt;">
          <mxGeometry x="16" y="560" width="828" height="90" as="geometry" />
        </mxCell>
        <mxCell id="apiNote2" parent="api" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#888888;fillColor=#ffffff;dashed=1;" value="&lt;b&gt;No webhooks, no host-platform push&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;the original design sketched signed callbacks to a host fintech platform; only the polling / SSE endpoints above exist today.&lt;/span&gt;">
          <mxGeometry x="16" y="660" width="828" height="80" as="geometry" />
        </mxCell>
        <mxCell id="apiNote3" parent="api" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#f2f2f2;" value="&lt;b&gt;Job queue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;in-process asyncio, not Postgres-backed — a single container and Groq's own rate limit make a durable queue unnecessary for now. A restart marks any interrupted job failed.&lt;/span&gt;">
          <mxGeometry x="16" y="750" width="828" height="90" as="geometry" />
        </mxCell>

        <mxCell id="dm" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;strokeColor=#000000;fillColor=#f7f7f7;" value="&lt;b&gt;DATA MODEL&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;six tables — the schema this app actually persists&lt;/span&gt;">
          <mxGeometry x="940" y="110" width="920" height="920" as="geometry" />
