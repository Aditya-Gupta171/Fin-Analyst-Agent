        <mxCell id="be4a" parent="be4" vertex="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" value="&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li&gt;Safe expression DSL (whitelisted AST, no eval)&lt;/li&gt;&lt;li&gt;97 taxonomy items · 59 metrics · 55 rules in 5 YAML packs&lt;/li&gt;&lt;li&gt;3-valued rule logic — missing data ≠ false&lt;/li&gt;&lt;li&gt;Robust anomaly detection (median / MAD z-score) vs history &amp;amp; cohort&lt;/li&gt;&lt;/ul&gt;">
          <mxGeometry x="12" y="34" width="286" height="226" as="geometry" />
        </mxCell>
