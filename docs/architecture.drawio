        <mxCell id="c28" value="&lt;b&gt;metrics/working_capital.yaml&lt;/b&gt;&lt;br&gt;&lt;br&gt;key: dso&lt;br&gt;formula: avg(trade_receivables)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ revenue * days&lt;br&gt;unit: days&lt;br&gt;better: lower&lt;br&gt;sectors: all_except [bfsi]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Courier New;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="c27">
          <mxGeometry x="15" y="45" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;rules/core/working_capital.yaml&lt;/b&gt;&lt;br&gt;&lt;br&gt;id: WC_RECEIVABLES_OUTPACE_REVENUE&lt;br&gt;packs: [core, quarterly, rhp]&lt;br&gt;when: growth(trade_receivables)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;- growth(revenue) &amp;gt; 0.20&lt;br&gt;&amp;nbsp;&amp;nbsp;and dso &amp;gt; cohort_pct(dso, 90)&lt;br&gt;severity: high&lt;br&gt;kb: working-capital/receivables&lt;br&gt;ask: Were credit terms extended?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Courier New;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="c27">
          <mxGeometry x="290" y="45" width="340" height="190" as="geometry" />
