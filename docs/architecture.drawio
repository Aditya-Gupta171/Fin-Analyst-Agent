        <mxCell id="L8" parent="L" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;strokeColor=#000000;fillColor=#f2f2f2;strokeWidth=2;" value="&lt;b&gt;Approve → promoted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333;&quot;&gt;written into rules/packs/learned/proposed.yaml — reviewable before commit, active on the next restart&lt;/span&gt;">
